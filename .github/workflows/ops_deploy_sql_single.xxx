# .github/workflows/deploy.yml

name: GCP Keyless Deployment

on:
  push:
    branches:
      - main
    paths:
      - 'bigquery/ops/**'
      - '.github/workflows/ops_deploy_sql.yml'
      
jobs:
  deploy_bq_migration:
    runs-on: ubuntu-latest
    
    # CRITICAL: Grants the job permission to fetch the OIDC token
    permissions:
      id-token: write 
      contents: read 

    steps:
      - uses: actions/checkout@v4
      
      # Step 1: Authenticate as the Central Jenkins SA
      # This uses the secrets you just set up (GCP_SA_EMAIL & GCP_WIF_PROVIDER_ID)
      - name: Authenticate to Google Cloud via WIF
        uses: 'google-github-actions/auth@v2'
        id: auth
        with:
          workload_identity_provider: ${{ secrets.GCP_WIF_PROVIDER_ID }}
          service_account: ${{ secrets.GCP_SA_EMAIL }}
      
      # Step 2: Deploy BigQuery Schema Migration
      # This step must be repeated for every project (e.g., prod, dev, etc.)
      - name: Deploy to Shared NP Project
        env:
          # Define the target credentials for this specific environment (Spoke Project)
          TARGET_SA_EMAIL: project-service-account@prj-lbd-shared-np.iam.gserviceaccount.com
          TARGET_PROJECT_ID: prj-lbd-shared-np

        run: |
          echo "--- Starting Deployment to ${{ env.TARGET_PROJECT_ID }} ---"
          
          # 1. IMPERSONATE: Use the Jenkins SA (ambient identity) to fetch 
          # the token for the TARGET_SA and set it as the default context.
          gcloud config set auth/impersonate_service_account "${{ env.TARGET_SA_EMAIL }}"

          # --- DEPLOYMENT STEP A: SCHEMA DEFINITION ---
          SCHEMA_FILE="bigquery/ops/tables/standards_definition.sql" 
          echo "Running schema definition: ${SCHEMA_FILE}"

          # 2. EXECUTE: The 'bq query' command now automatically uses the 
          # impersonated identity (the Target SA token). No '--token' needed.
          bq query \
             --use_legacy_sql=false \
             --project_id="${{ env.TARGET_PROJECT_ID }}" \
             < ${SCHEMA_FILE}
          
          echo "Schema definition complete."

          # --- DEPLOYMENT STEP B: DATA INSERTION/SEEDS ---
          DATA_FILE="bigquery/ops/seeds/bronze_v1_standards.sql"
          echo "Running data insertion: ${DATA_FILE}"

          bq query \
             --use_legacy_sql=false \
             --project_id="${{ env.TARGET_PROJECT_ID }}" \
             < ${DATA_FILE}
          
          echo "Data insertion complete. Deployment finished."


js {
    const std = require("includes/std_assertions");
}

config {
  type: "assertion",
  name: "assert_conditions_integrity",
  description: "Combined DQ Gate: Unique Keys, Strict Whitespace (tabs/newlines), and Standard Null checks."
}

/** * 1. UNIQUE CHECK 
 * Ensures no duplicate condition records exist for the same patient/encounter/code.
 */
${std.unique_check(
  ["patient", "encounter", "code", "start"], 
  ref({
    database: dataform.projectConfig.vars.bronze_project,
    schema: dataform.projectConfig.vars.bronze_dataset,
    name: "conditions"
  })
)}

UNION ALL

/** * 2. NO WHITESPACE CHECK (The "Strict" Check)
 * Specifically catches hidden tabs, newlines, or empty strings in core fields.
 */
${std.no_whitespace_check(
  ["patient", "code"], 
  ref({
    database: dataform.projectConfig.vars.bronze_project,
    schema: dataform.projectConfig.vars.bronze_dataset,
    name: "conditions"
  })
)}

UNION ALL

/** * 3. NOT NULL CHECK (The "Standard" Check)
 * Ensures mandatory clinical fields are populated.
 */
${std.not_null_check(
  ["start", "patient", "code"], 
  ref({
    database: dataform.projectConfig.vars.bronze_project,
    schema: dataform.projectConfig.vars.bronze_dataset,
    name: "conditions"
  })
)}